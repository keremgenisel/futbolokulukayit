{
  "name": "eyupspor-aktivasyon",
  "private": true,
  "type": "module",
  "description": "Eyüpspor Futbol Okulu lisans aktivasyon sunucusu (Cloudflare Worker + D1)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute eyupspor-lisans --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute eyupspor-lisans --local --file=schema.sql"
  },
  "devDependencies": {
    "wrangler": "^3.80.0"
  }
}
