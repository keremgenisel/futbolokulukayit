{
  "name": "futbol-okulu-kayit-programi",
  "productName": "Futbol Okulu Kayıt Programı",
  "version": "0.1.0",
  "description": "Futbol Okulu Kayıt Programı — oyuncu kayıt, aidat, makbuz ve yoklama",
  "main": "electron/main.cjs",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "postinstall": "electron-rebuild -f -w better-sqlite3 -w better-sqlite3-multiple-ciphers",
    "prepare": "node scripts/install-git-hooks.cjs",
    "hooks": "node scripts/install-git-hooks.cjs",
    "predev": "node scripts/ensure-native.cjs",
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "build:win": "vite build && electron-builder --win",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint src electron scripts",
    "typecheck": "tsc --noEmit",
    "scan:secrets": "gitleaks git . --config .gitleaks.toml --redact --verbose",
    "audit": "npm audit --audit-level=high",
    "test:saf": "vitest run --exclude 'tests/{db-electron,kalicilik,server-security,sezon-e2e,tasima-e2e,raporlar-e2e,oyuncular-e2e,sayfalama-e2e}.test.js'",
    "test:coverage": "vitest run --coverage --exclude 'tests/{db-electron,kalicilik,server-security,sezon-e2e,tasima-e2e,raporlar-e2e,oyuncular-e2e,sayfalama-e2e}.test.js'",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"electron/**/*.cjs\" \"scripts/**/*.cjs\" \"tests/**/*.{js,jsx}\" \"aktivasyon-sunucu/src/*.js\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"electron/**/*.cjs\" \"scripts/**/*.cjs\" \"tests/**/*.{js,jsx}\" \"aktivasyon-sunucu/src/*.js\""
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "better-sqlite3-multiple-ciphers": "^12.11.1",
    "compression": "^1.8.1",
    "electron-updater": "^6.3.9",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "fflate": "^0.8.3",
    "jsonwebtoken": "^9.0.2",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "selfsigned": "^5.5.0",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.3",
    "cross-env": "^7.0.3",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "shell-quote": "^1.10.0",
    "js-yaml": "^4.3.1",
    "body-parser": "^1.20.6"
  },
  "build": {
    "appId": "com.keremgenisel.futbolokulu",
    "productName": "Futbol Okulu Kayıt Programı",
    "artifactName": "Futbol-Okulu-Kayit-Programi-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/better-sqlite3-multiple-ciphers/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "npmRebuild": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Futbol Okulu Kayıt Programı",
      "perMachine": true,
      "allowElevation": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "keremgenisel",
        "repo": "eyupspor",
        "releaseType": "release"
      }
    ],
    "icon": "build/icon.png",
    "extraMetadata": {
      "author": "Kerem Genişel"
    }
  },
  "author": {
    "name": "Kerem Genişel"
  }
}
